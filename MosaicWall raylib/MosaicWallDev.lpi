<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="MosaicWall Dev"/>
      <Scaled Value="True"/>
      <ResourceType Value="res"/>
      <UseXPManifest Value="True"/>
      <XPManifest>
        <DpiAware Value="True"/>
      </XPManifest>
    </General>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="MosaicWallDev.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="uDevForm.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="DevForm"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="Form"/>
      </Unit>
      <Unit><Filename Value="uMosaicEngine.pas"/><IsPartOfProject Value="True"/></Unit>
      <Unit><Filename Value="uMosaicReport.pas"/><IsPartOfProject Value="True"/></Unit>
      <Unit><Filename Value="uMosaicStats.pas"/><IsPartOfProject Value="True"/></Unit>
      <Unit><Filename Value="uSysInfo.pas"/><IsPartOfProject Value="True"/></Unit>
      <Unit><Filename Value="uMosaicRender.pas"/><IsPartOfProject Value="True"/></Unit>
      <Unit><Filename Value="uMosaicGen.pas"/><IsPartOfProject Value="True"/></Unit>
      <Unit><Filename Value="uMosaicTypes.pas"/><IsPartOfProject Value="True"/></Unit>
      <Unit><Filename Value="uPalette.pas"/><IsPartOfProject Value="True"/></Unit>
      <Unit><Filename Value="uNoise.pas"/><IsPartOfProject Value="True"/></Unit>
      <Unit><Filename Value="raylib.pas"/><IsPartOfProject Value="True"/></Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="MosaicWallDev"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <UnitOutputDirectory Value="lib\dev\$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <CodeGeneration>
      <TargetCPU Value="x86_64"/>
      <TargetOS Value="win64"/>
      <Optimizations>
        <OptimizationLevel Value="2"/>
      </Optimizations>
    </CodeGeneration>
    <Linking>
      <Debugging>
        <GenerateDebugInfo Value="False"/>
      </Debugging>
      <Options>
        <Win32>
          <GraphicApplication Value="True"/>
        </Win32>
      </Options>
    </Linking>
  </CompilerOptions>
</CONFIG>
