      end
    end
    object pbGraph: TPaintBox
      Left = 180
      Height = 140
      Top = 0
      Width = 540
      Align = alClient
      OnPaint = pbGraphPaint
    end
  end
  object sbMain: TStatusBar
    Left = 0
    Height = 23
    Top = 937
    Width = 720
    Panels = <>
    SimplePanel = True
  end
  object pnlRight: TPanel
