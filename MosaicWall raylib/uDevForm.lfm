        Font.Style = [fsBold]
        ParentFont = False
      end
      object lblFrame: TLabel
        Left = 10
        Height = 15
        Top = 46
        Width = 80
        Caption = 'frame -- ms'
      end
      object lblCpu: TLabel
        Left = 10
        Height = 15
        Top = 66
        Width = 80
        Caption = 'cpu -- ms'
      end
      object lblDraw: TLabel
        Left = 10
        Height = 15
