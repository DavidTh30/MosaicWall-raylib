        Left = 4
        Height = 32
        Top = 206
        Width = 228
        Frequency = 25
        Max = 300
        OnChange = tbMotionChange
        Position = 100
        TabOrder = 12
      end
      object cbAnimate: TCheckBox
        Left = 8
        Height = 19
        Top = 242
        Width = 120
        Caption = 'Animate  (Space)'
