      Caption = 'Scene controls'
      ClientHeight = 416
      ClientWidth = 238
      TabOrder = 0
      object lblSeed: TLabel
        Left = 8
        Height = 15
        Top = 4
        Width = 25
        Caption = 'Seed'
      end
      object seSeed: TSpinEdit
        Left = 8
        Height = 23
        Top = 22
        Width = 118
        MaxValue = 999999999
        TabOrder = 0
        Value = 653
      end
      object btnApplySeed: TButton
        Left = 132
        Height = 25
        Top = 21
        Width = 98
        Caption = 'Apply seed'
        OnClick = btnApplySeedClick
        TabOrder = 1
      end
      object btnReseed: TButton
        Left = 8
        Height = 25
        Top = 52
        Width = 222
        Caption = 'New random seed  (R)'
        OnClick = btnReseedClick
        TabOrder = 2
      end
      object lblCell: TLabel
        Left = 8
        Height = 15
        Top = 86
        Width = 120
        Caption = 'Cell size ratio: 0.076'
      end
      object tbCell: TTrackBar
        Left = 4
        Height = 32
        Top = 104
        Width = 228
        Frequency = 10
        Max = 120
        Min = 40
        OnChange = tbCellChange
        Position = 76
        TabOrder = 3
      end
      object lblGlow: TLabel
        Left = 8
        Height = 15
        Top = 142
        Width = 90
        Caption = 'Glow mode  (G)'
      end
      object cbGlow: TComboBox
        Left = 8
        Height = 23
        Top = 160
        Width = 222
        ItemHeight = 15
        ItemIndex = 1
        Items.Strings = (
          '0 - off'
          '1 - soft glow'
          '2 - glow + colour bleed'
        )
        OnChange = cbGlowChange
        Style = csDropDownList
        TabOrder = 4
        Text = '1 - soft glow'
      end
      object lblMotion: TLabel
        Left = 8
        Height = 15
        Top = 190
        Width = 150
        Caption = 'Motion: 100 %   ( [ ] )'
      end
