object DevForm: TDevForm
  Left = 16
  Height = 960
  Top = 16
  Width = 720
  Caption = 'MosaicWall - Developer Status'
  ClientHeight = 960
  ClientWidth = 720
  Constraints.MinHeight = 600
  Constraints.MinWidth = 600
  Position = poDesigned
  OnClose = FormClose
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  object pnlTop: TPanel
    Left = 0
    Height = 140
    Top = 0
    Width = 720
    Align = alTop
    BevelOuter = bvNone
